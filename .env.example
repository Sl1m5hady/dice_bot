# Telegram token. Leave empty to read token.txt.
TELEGRAM_TOKEN=
# Telegram chat ID. Negative for a group, positive for a private chat.
TELEGRAM_CHAT_ID=

# Shared website access code and an independent session secret.
WEB_ACCESS_CODE=
# Separate optional admin code for changing the Telegram destination.
WEB_ADMIN_CODE=
WEB_SESSION_SECRET=

# Required for the production Compose stack.
DICE_DOMAIN=
CERTBOT_EMAIL=
